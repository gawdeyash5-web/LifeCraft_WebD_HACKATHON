# ============================================================
# LIFECRAFT Backend Environment Variables (Railway / Local Dev)
# ============================================================
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Hosted PostgreSQL Connection URL (Provided automatically by Railway PostgreSQL plugin)
# Format: postgresql://postgres:password@host:port/railway
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
