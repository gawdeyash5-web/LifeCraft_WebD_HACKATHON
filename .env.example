# ==========================================
# LIFECRAFT - Monorepo Environment Variables
# Copy this to .env or use individual configs
# in /frontend and /backend
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL) - Optional if using embedded PGlite
DATABASE_URL=postgresql://username:password@localhost:5432/lifecraft

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
