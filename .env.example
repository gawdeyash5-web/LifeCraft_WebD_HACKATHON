# ============================================================
# LIFECRAFT - Vercel Full-Stack + Neon PostgreSQL Environment Template
# ============================================================

# --- VERCEL PRODUCTION ENVIRONMENT VARIABLES ---
# Neon Hosted PostgreSQL Connection String (use pooled endpoint)
# Format: postgresql://<user>:<password>@<ep-xyz-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Optional Serverless Pool Configuration (default 10)
DB_POOL_MAX=10

# Optional: Custom domain for CORS (Vercel preview & production *.vercel.app are automatically allowed)
FRONTEND_URL=https://your-project.vercel.app

# --- LOCAL DEVELOPMENT ---
# When DATABASE_URL is unset, local development automatically falls back to embedded PGlite.
PORT=5000
