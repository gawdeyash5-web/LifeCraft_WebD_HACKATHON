{
  "name": "lifecraft",
  "version": "0.1.0",
  "private": true,
  "description": "LifeCraft - Gamified Real-Life Productivity RPG with 3D World Visualization",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "lifecraft",
    "gamification",
    "rpg",
    "productivity",
    "threejs",
    "react-three-fiber",
    "hackathon"
  ],
  "author": "LIFECRAFT Team",
  "license": "MIT"
}
